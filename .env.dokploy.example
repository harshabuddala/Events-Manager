# =============================================================================
# Environment Variables for Dokploy Deployment
# Copy these into Dokploy's Environment tab (not into .env files)
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=edunura
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=edunura
DATABASE_URL=postgresql://edunura:<password>@edunura-db:5432/edunura

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=<generate-a-strong-random-secret>

# ─── Admin Account ───────────────────────────────────────────────────────────
# Default on first seed: admin@edunura.com / admin123
# Set a strong password here to override the default
ADMIN_PASSWORD=<set-a-strong-admin-password>

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8472

# ─── Domain (set in Dokploy Domain tab or here for Traefik labels) ──────────
APP_DOMAIN=edunura.yourdomain.com

# ─── Razorpay (Optional - for paid registrations) ──────────────────────────
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx
