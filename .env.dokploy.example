# =============================================================================
# Environment Variables for Dokploy Deployment
# ─────────────────────────────────────────────
# HOW TO USE:
#   1. Copy the values you need from this file
#   2. Paste them into Dokploy → your service → Environment tab
#   3. Do NOT commit real secrets to git — this file is an example only
# =============================================================================


# ─── Database ────────────────────────────────────────────────────────────────
# These are used by both the PostgreSQL container and the Next.js app.
# The password in DATABASE_URL must match POSTGRES_PASSWORD exactly.

POSTGRES_USER=edunura
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=edunura
DATABASE_URL=postgresql://edunura:<password>@edunura-db:5432/edunura


# ─── Authentication ──────────────────────────────────────────────────────────
# Used to sign/verify JWT session tokens. Must be a long random string.
# Generate one with: openssl rand -base64 32

JWT_SECRET=<generate-a-strong-random-secret>


# ─── Admin Account ───────────────────────────────────────────────────────────
# Password for the default admin account (admin@edunura.com).
# Set this before first deploy — it overrides the default "admin123" seed password.

ADMIN_PASSWORD=<set-a-strong-admin-password>


# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8472


# ─── Domain ──────────────────────────────────────────────────────────────────
# APP_DOMAIN  → Used by Traefik routing labels in docker-compose.yml
# APP_URL     → Used internally for self-referential links (QR codes on ID cards,
#               WhatsApp message links, etc.). Must include https:// and no trailing slash.
#
# Both should point to the same domain where your Next.js app is deployed.
# Example: if your Dokploy domain is events.yourdomain.com, set both to that.

APP_DOMAIN=events.edunura.com
APP_URL=https://events.edunura.com


# ─── Razorpay ─────────────────────────────────────────────────────────────────
# OPTIONAL — only needed for paid event registrations.
# These env vars are a fallback only. The primary way to configure Razorpay
# is via the admin dashboard: Settings → Razorpay (stored in the database).
#
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_* keys for testing, rzp_live_* keys for production.

# RAZORPAY_KEY_ID=rzp_live_xxxxx
# RAZORPAY_KEY_SECRET=xxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxx


# ─── WhatsApp ────────────────────────────────────────────────────────────────
# WhatsApp Business API credentials are configured via the admin dashboard:
# Settings → WhatsApp (stored in the database — no env vars needed here).


# ─── Landing Page (edunura-landing-page) ─────────────────────────────────────
# The registration landing page is a separate static Vite app.
# It is NOT deployed via this docker-compose — it must be deployed separately
# (e.g. Netlify, Vercel, Cloudflare Pages, or a static file host).
#
# After deploying the landing page, set this variable inside the landing page
# source file before building:
#
#   File: edunura-landing-page/src/components/RegistrationForm.tsx
#   Line: const API_BASE_URL = 'https://events.edunura.com';  ← already updated
#                                        ↑ same as APP_URL above
#
# The landing page URL itself (where parents go to register) is separate and
# depends on where you host the static files (not configured here).
