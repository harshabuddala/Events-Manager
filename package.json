{
  "name": "edunura-events",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8472",
    "dev:https": "node https-dev-server.js",
    "dev:clean": "rm -rf .next && next dev -p 8472",
    "dev:network": "rm -rf .next && next dev -p 8472 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start -p 8472",
    "lint": "eslint .",
    "clean": "rm -rf .next",
    "seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run seed",
    "restart": "npm run clean && npm run dev"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.3",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "pg": "^8.21.0",
    "postcss": "^8.5.6",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.3.1",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "4.1.11",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
